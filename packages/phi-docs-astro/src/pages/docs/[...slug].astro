---
import DocsPageNavigation from "../../components/DocsPageNavigation.astro";
import { mockNavPages } from "../../data/docs-nav";
import DocsLayout from "../../layouts/DocsLayout.astro";

export function getStaticPaths() {
  return mockNavPages.map((page) => ({
    params: {
      slug: page.href.replace(/^\/docs\/?/, ""),
    },
    props: { page },
  }));
}

const { page } = Astro.props;
const sectionLabel = page.section ?? "Docs";
---

<DocsLayout title={page.label} description={page.description}>
  <div class="docs-prose">
    <div class="docs-placeholder-title-row">
      <h1>{page.label}</h1>
      <DocsPageNavigation currentPath={page.href} variant="compact" />
    </div>
    <p>{page.description}</p>
    <p>This navigation placeholder reserves the final documentation route and shell layout.</p>

    <h2>Section</h2>
    <p>{sectionLabel}</p>

    <h2>Path</h2>
    <pre><code>{page.href}</code></pre>
    <DocsPageNavigation currentPath={page.href} />
  </div>
</DocsLayout>
