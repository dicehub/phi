---
import ArkUiDocsLink from "../../../components/ArkUiDocsLink.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import SidebarDocsDemo from "../../../components/SidebarDocsDemo.vue";
import SidebarFullScreenMobileDemo from "../../../components/SidebarFullScreenMobileDemo.vue";
import SidebarLoadingDemo from "../../../components/SidebarLoadingDemo.vue";
import SidebarScrollDocsDemo from "../../../components/SidebarScrollDocsDemo.vue";
import { sidebarScrollCode } from "../../../data/sidebar-scroll-docs";
import { sidebarAccessibilityRows, sidebarApiSections } from "../../../data/sidebar-api-docs";
import {
  sidebarBarrelCode,
  sidebarExamples,
  sidebarFullScreenMobileExample,
  sidebarGranularCode,
  sidebarLoadingExample,
  sidebarPreviewCode,
  sidebarUsageCode,
} from "../../../data/sidebar-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/component-docs.css";

const getDescriptionParts = (description: string) =>
  description.split(/(`[^`]+`)/g).map((part) => ({
    kind: part.startsWith("`") && part.endsWith("`") ? "code" : "text",
    value: part.startsWith("`") && part.endsWith("`") ? part.slice(1, -1) : part,
  }));
---

<DocsLayout
  title="Sidebar"
  description="A composable sidebar navigation component with collapsible groups, icon-only mode, peeking, sliding views, and responsive mobile support."
>
  <div class="docs-page docs-page--component docs-page--sidebar">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-copy">
            <CopyPageControls client:only="vue" align="center" />
          </div>

          <div class="docs-page-header__title-row">
            <h1>Sidebar</h1>
            <ArkUiDocsLink />
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-copy">
                <CopyPageControls client:only="vue" />
              </div>
              <DocsPageNavigation currentPath={Astro.url.pathname} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">
            A composable sidebar navigation component with collapsible groups, icon-only mode, peeking, sliding views, and responsive mobile support.
          </p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--sidebar">
              <SidebarDocsDemo client:only="vue" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={sidebarPreviewCode} lang="vue" />
            </div>
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>

          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={sidebarBarrelCode} lang="typescript" />

          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={sidebarGranularCode} lang="typescript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            At minimum you need <code>Provider</code>, <code>Sidebar</code>, <code>Content</code>, <code>Menu</code>, and <code>MenuButton</code>.
            Add <code>Header</code> and <code>Footer</code> to pin content above or below the scroll area.
          </p>
          <CodeBlock code={sidebarUsageCode} lang="vue" />
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>

          <h3 id={sidebarLoadingExample.id}>
            <a class="docs-section-anchor" href={`#${sidebarLoadingExample.id}`}>{sidebarLoadingExample.title}</a>
          </h3>
          <p>
            {
              getDescriptionParts(sidebarLoadingExample.description).map((part) =>
                part.kind === "code" ? <code>{part.value}</code> : part.value,
              )
            }
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--sidebar">
              <SidebarLoadingDemo client:only="vue" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={sidebarLoadingExample.code} lang="vue" />
            </div>
          </div>

          {
            sidebarExamples.map((example) => (
              <>
                <h3 id={example.id}>
                  <a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a>
                </h3>
                <p>
                  {
                    getDescriptionParts(example.description).map((part) =>
                      part.kind === "code" ? <code>{part.value}</code> : part.value,
                    )
                  }
                </p>
                <div class="docs-component-example">
                  <div class="docs-component-preview docs-component-preview--sidebar">
                    <SidebarDocsDemo client:only="vue" variant={example.variant} />
                  </div>
                  <div class="docs-component-example__code">
                    <CodeBlock code={example.code} lang="vue" />
                  </div>
                </div>
              </>
            ))
          }

          <h3 id={sidebarFullScreenMobileExample.id}>
            <a class="docs-section-anchor" href={`#${sidebarFullScreenMobileExample.id}`}>
              {sidebarFullScreenMobileExample.title}
            </a>
          </h3>
          <p>
            {
              getDescriptionParts(sidebarFullScreenMobileExample.description).map((part) =>
                part.kind === "code" ? <code>{part.value}</code> : part.value,
              )
            }
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--sidebar">
              <SidebarFullScreenMobileDemo client:only="vue" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={sidebarFullScreenMobileExample.code} lang="vue" />
            </div>
          </div>
        </section>

        <section id="scrolling-to-items" class="docs-section">
          <h2><a class="docs-section-anchor" href="#scrolling-to-items">Scrolling to Items</a></h2>
          <p>
            Set a unique <code>itemId</code> on <code>Sidebar.MenuItem</code> or <code>Sidebar.MenuButton</code>.
            Call <code>useSidebar().scrollItemIntoView(id, options)</code> to reveal an item only when it is outside
            its viewport. A fully visible item stays in place, even with explicit alignment.
            Use <code>scrollToItem</code> to align an item even when it is already visible.
          </p>
          <p>
            Both methods scroll only the owning <code>Sidebar.Content</code> viewport and support scaled containers.
            Missing or unmounted items have no effect. Use the default <code>align: "auto"</code> for the minimum
            scroll distance, or choose <code>"start"</code>, <code>"center"</code>, or <code>"end"</code>.
            <code>behavior: "smooth"</code> respects reduced motion. Item IDs must be unique within each provider.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--sidebar">
              <SidebarScrollDocsDemo client:only="vue" />
            </div>
            <div class="docs-component-example__code"><CodeBlock code={sidebarScrollCode} lang="vue" /></div>
          </div>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>

          {
            sidebarApiSections.map((section) => (
              <>
                <h3 id={section.id}><a class="docs-section-anchor" href={`#${section.id}`}>{section.title}</a></h3>
                <p>
                  {
                    getDescriptionParts(section.description).map((part) =>
                      part.kind === "code" ? <code>{part.value}</code> : part.value,
                    )
                  }
                </p>
                <div class="docs-api-table">
                  <table>
                    <thead>
                      <tr><th>Prop / Event</th><th>Type</th><th>Default</th><th>Description</th></tr>
                    </thead>
                    <tbody>
                      {section.rows.map((prop) => (
                        <tr>
                          <td><code>{prop.name}</code></td>
                          <td><code>{prop.type}</code></td>
                          <td><code>{prop.defaultValue}</code></td>
                          <td>
                            {
                              getDescriptionParts(prop.description).map((part) =>
                                part.kind === "code" ? <code>{part.value}</code> : part.value,
                              )
                            }
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </>
            ))
          }
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <div class="docs-accessibility-list">
            {
              sidebarAccessibilityRows.map((row) => (
                <div class="docs-accessibility-list__item">
                  <h3>{row.title}</h3>
                  <p>
                    {
                      getDescriptionParts(row.description).map((part) =>
                        part.kind === "code" ? <code>{part.value}</code> : part.value,
                      )
                    }
                  </p>
                </div>
              ))
            }
          </div>
        </section>
        <DocsPageNavigation currentPath={Astro.url.pathname} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li>
              <a href="#installation">Installation</a>
              <ul>
                <li><a href="#barrel">Barrel</a></li>
                <li><a href="#granular">Granular</a></li>
              </ul>
            </li>
            <li><a href="#usage">Usage</a></li>
            <li>
              <a href="#examples">Examples</a>
              <ul>
                <li><a href={`#${sidebarLoadingExample.id}`}>{sidebarLoadingExample.title}</a></li>
                {sidebarExamples.map((example) => <li><a href={`#${example.id}`}>{example.title}</a></li>)}
                <li><a href={`#${sidebarFullScreenMobileExample.id}`}>{sidebarFullScreenMobileExample.title}</a></li>
              </ul>
            </li>
            <li><a href="#scrolling-to-items">Scrolling to Items</a></li>
            <li>
              <a href="#api-reference">API Reference</a>
              <ul>
                {sidebarApiSections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}
              </ul>
            </li>
            <li><a href="#accessibility">Accessibility</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
