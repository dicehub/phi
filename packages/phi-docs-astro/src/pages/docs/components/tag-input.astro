---
import CodeBlock from "../../../components/CodeBlock.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import TagInputDocsDemo from "../../../components/TagInputDocsDemo.vue";
import {
  tagInputBarrelCode,
  tagInputEvents,
  tagInputExamples,
  tagInputGranularCode,
  tagInputLabelKeys,
  tagInputPreviewCode,
  tagInputProps,
  tagInputSlots,
  tagInputUsageCode,
} from "../../../data/tag-input-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/component-docs.css";
---

<DocsLayout title="Tag Input" description="A creatable multi-value input for values that do not come from a predefined option list.">
  <div class="docs-page docs-page--component docs-page--tag-input">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-copy">
            <CopyPageControls client:only="vue" align="center" />
          </div>

          <div class="docs-page-header__title-row">
            <h1>Tag Input</h1>
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-copy">
                <CopyPageControls client:only="vue" />
              </div>
              <DocsPageNavigation currentPath={Astro.url.pathname} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">
            A creatable multi-value input for values that do not come from a predefined option list.
          </p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--tag-input">
              <TagInputDocsDemo client:only="vue" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={tagInputPreviewCode} lang="vue" />
            </div>
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>

          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={tagInputBarrelCode} lang="typescript" />

          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={tagInputGranularCode} lang="typescript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            Use <code>v-model</code> for controlled tags and <code>defaultValue</code> for uncontrolled usage.
            Enter, comma, Tab, and blur commit the current text.
          </p>
          <CodeBlock code={tagInputUsageCode} lang="vue" />
          <p>
            The component exposes its native input as <code>input</code>, so a template ref can focus the
            field or read the underlying element.
          </p>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>

          {
            tagInputExamples.map((example) => (
              <>
                <h3 id={example.id}>
                  <a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a>
                </h3>
                <p>{example.description}</p>
                <div class="docs-component-example">
                  <div class="docs-component-preview docs-component-preview--tag-input">
                    <TagInputDocsDemo client:only="vue" variant={example.variant} />
                  </div>
                  <div class="docs-component-example__code">
                    <CodeBlock code={example.code} lang="vue" />
                  </div>
                </div>
              </>
            ))
          }
        </section>

        <section id="behavior" class="docs-section">
          <h2><a class="docs-section-anchor" href="#behavior">Behavior</a></h2>
          <ul>
            <li>Enter, comma, or Tab commits the current text as a tag. Blur commits the text too.</li>
            <li>Pasting comma- or newline-separated text creates every value synchronously.</li>
            <li>Duplicate values are ignored, so each tag appears once.</li>
            <li>Backspace removes the last tag only while the input is empty.</li>
            <li>
              When <code>maxValues</code> is reached or <code>validateValue</code> rejects a value, the
              remaining text stays in the input and the matching localized message replaces the description.
            </li>
          </ul>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <p>TagInput accepts standard HTML input attributes plus the following:</p>

          <h3 id="props"><a class="docs-section-anchor" href="#props">Props</a></h3>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
              </thead>
              <tbody>
                {tagInputProps.map((prop) => (
                  <tr>
                    <td><code>{prop.name}</code></td>
                    <td><code>{prop.type}</code></td>
                    <td><code>{prop.defaultValue}</code></td>
                    <td>{prop.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 id="slots"><a class="docs-section-anchor" href="#slots">Slots</a></h3>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Slot</th><th>Description</th></tr>
              </thead>
              <tbody>
                {tagInputSlots.map((slot) => (
                  <tr>
                    <td><code>{slot.name}</code></td>
                    <td>{slot.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 id="events"><a class="docs-section-anchor" href="#events">Events</a></h3>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Event</th><th>Type</th><th>Description</th></tr>
              </thead>
              <tbody>
                {tagInputEvents.map((event) => (
                  <tr>
                    <td><code>{event.name}</code></td>
                    <td><code>{event.type}</code></td>
                    <td>{event.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 id="labels"><a class="docs-section-anchor" href="#labels">Labels</a></h3>
          <p>Use <code>labels</code> to translate every string TagInput generates.</p>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Key</th><th>Type</th><th>Description</th></tr>
              </thead>
              <tbody>
                {tagInputLabelKeys.map((key) => (
                  <tr>
                    <td><code>{key.name}</code></td>
                    <td><code>{key.type}</code></td>
                    <td>{key.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>

          <h3 id="label-requirement"><a class="docs-section-anchor" href="#label-requirement">Label Requirement</a></h3>
          <p>
            Prefer the <code>label</code> prop or label slot. Without a visible label, TagInput falls back to
            <code>aria-label</code> and then to the localized <code>labels.input</code> name.
          </p>

          <h3 id="tag-removal"><a class="docs-section-anchor" href="#tag-removal">Tag Removal</a></h3>
          <p>
            Every tag renders a button named by <code>labels.removeValue</code>, so assistive technology can
            remove a tag without keyboard navigation through the input.
          </p>

          <h3 id="validation-feedback"><a class="docs-section-anchor" href="#validation-feedback">Validation Feedback</a></h3>
          <p>
            Invalid and over-limit states set <code>aria-invalid</code> and associate the message through
            <code>aria-describedby</code>.
          </p>
        </section>
        <DocsPageNavigation currentPath={Astro.url.pathname} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li>
              <a href="#installation">Installation</a>
              <ul>
                <li><a href="#barrel">Barrel</a></li>
                <li><a href="#granular">Granular</a></li>
              </ul>
            </li>
            <li><a href="#usage">Usage</a></li>
            <li>
              <a href="#examples">Examples</a>
              <ul>
                {tagInputExamples.map((example) => <li><a href={`#${example.id}`}>{example.title}</a></li>)}
              </ul>
            </li>
            <li><a href="#behavior">Behavior</a></li>
            <li>
              <a href="#api-reference">API Reference</a>
              <ul>
                <li><a href="#props">Props</a></li>
                <li><a href="#slots">Slots</a></li>
                <li><a href="#events">Events</a></li>
                <li><a href="#labels">Labels</a></li>
              </ul>
            </li>
            <li>
              <a href="#accessibility">Accessibility</a>
              <ul>
                <li><a href="#label-requirement">Label Requirement</a></li>
                <li><a href="#tag-removal">Tag Removal</a></li>
                <li><a href="#validation-feedback">Validation Feedback</a></li>
              </ul>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
