---
import ArkUiDocsLink from "../../../components/ArkUiDocsLink.astro";
import DicehubLogoDocsDemo from "../../../components/DicehubLogoDocsDemo.vue";
import CodeBlock from "../../../components/CodeBlock.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/component-docs.css";

const barrelCode = `import {
  DicehubLogo,
  PoweredByDicehub,
  generateDicehubLogoSvg,
} from "@dicehub/phi";`;

const granularCode = `import {
  DicehubLogo,
  PoweredByDicehub,
  generateDicehubLogoSvg,
} from "@dicehub/phi/components/dicehub-logo";`;

const previewCode = `<script setup>
import { DicehubLogo } from "@dicehub/phi/components/dicehub-logo";
</script>

<template>
  <DicehubLogo style="width: 18rem;" />
</template>`;

const usageCode = `<script setup>
import { DicehubLogo } from "@dicehub/phi/components/dicehub-logo";
</script>

<template>
  <DicehubLogo style="width: 9rem;" />
</template>`;

const glyphCode = `<script setup>
import { DicehubLogo } from "@dicehub/phi/components/dicehub-logo";
</script>

<template>
  <DicehubLogo variant="glyph" style="width: 6rem;" />
</template>`;

const colorVariantsCode = `<script setup>
import { DicehubLogo } from "@dicehub/phi/components/dicehub-logo";
</script>

<template>
  <div class="flex flex-wrap items-center gap-8">
    <DicehubLogo color="color" style="width: 7rem;" />
    <div class="rounded-lg bg-white p-4">
      <DicehubLogo color="black" style="width: 7rem;" />
    </div>
    <div class="rounded-lg bg-black p-4">
      <DicehubLogo color="white" style="width: 7rem;" />
    </div>
  </div>
</template>`;

const glyphVariantsCode = `<script setup>
import { DicehubLogo } from "@dicehub/phi/components/dicehub-logo";
</script>

<template>
  <div class="flex flex-wrap items-center gap-8">
    <DicehubLogo variant="glyph" color="color" style="width: 3rem;" />
    <div class="rounded-lg bg-white p-4">
      <DicehubLogo variant="glyph" color="black" style="width: 3rem;" />
    </div>
    <div class="rounded-lg bg-black p-4">
      <DicehubLogo variant="glyph" color="white" style="width: 3rem;" />
    </div>
  </div>
</template>`;

const sizesCode = `<script setup>
import { DicehubLogo } from "@dicehub/phi/components/dicehub-logo";
</script>

<template>
  <div class="flex flex-wrap items-end gap-6">
    <DicehubLogo style="width: 5rem;" />
    <DicehubLogo style="width: 7rem;" />
    <DicehubLogo style="width: 11rem;" />
  </div>
</template>`;

const copyCode = `<script setup>
import { ref } from "vue";
import { Button } from "@dicehub/phi/components/button";
import {
  DicehubLogo,
  generateDicehubLogoSvg,
} from "@dicehub/phi/components/dicehub-logo";
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuSeparator,
  DropdownMenuTrigger,
} from "@dicehub/phi/components/dropdown";

const copied = ref(null);

const copyToClipboard = async (text, label) => {
  await navigator.clipboard.writeText(text);
  copied.value = label;
};
</script>

<template>
  <DropdownMenu>
    <DropdownMenuTrigger>
      <Button variant="primary">
        <DicehubLogo variant="glyph" color="white" style="width: 1.5rem;" />
        Logo
      </Button>
    </DropdownMenuTrigger>
    <DropdownMenuContent>
      <DropdownMenuItem
        value="glyph"
        @click="copyToClipboard(generateDicehubLogoSvg({ variant: 'glyph' }), 'glyph')"
      >
        {{ copied === "glyph" ? "Copied!" : "Copy mark as SVG" }}
      </DropdownMenuItem>
      <DropdownMenuItem
        value="full"
        @click="copyToClipboard(generateDicehubLogoSvg({ variant: 'full' }), 'full')"
      >
        {{ copied === "full" ? "Copied!" : "Copy full logo as SVG" }}
      </DropdownMenuItem>
      <DropdownMenuSeparator />
      <DropdownMenuItem value="guidelines">Visit brand guidelines</DropdownMenuItem>
    </DropdownMenuContent>
  </DropdownMenu>
</template>`;

const poweredBasicCode = `<script setup>
import { PoweredByDicehub } from "@dicehub/phi/components/dicehub-logo";
</script>

<template>
  <PoweredByDicehub />
</template>`;

const poweredVariantsCode = `<script setup>
import { PoweredByDicehub } from "@dicehub/phi/components/dicehub-logo";
</script>

<template>
  <div class="flex flex-wrap items-center gap-4">
    <PoweredByDicehub />
    <PoweredByDicehub color="black" />
    <div class="rounded-lg bg-black p-3">
      <PoweredByDicehub color="white" />
    </div>
  </div>
</template>`;

const poweredFooterCode = `<script setup>
import { PoweredByDicehub } from "@dicehub/phi/components/dicehub-logo";
</script>

<template>
  <footer class="flex w-full items-center justify-between rounded-lg border px-6 py-4">
    <span>© 2026 Your Company. All rights reserved.</span>
    <PoweredByDicehub />
  </footer>
</template>`;

const svgGenerationCode = `import { generateDicehubLogoSvg } from "@dicehub/phi/components/dicehub-logo";

// Generate mark SVG
const glyphSvg = generateDicehubLogoSvg({ variant: "glyph" });

// Generate full logo SVG
const fullSvg = generateDicehubLogoSvg({ variant: "full" });

// Generate black logo
const blackSvg = generateDicehubLogoSvg({ color: "black" });

// Copy to clipboard
await navigator.clipboard.writeText(
  generateDicehubLogoSvg({ variant: "glyph", color: "color" }),
);`;

const logoProps = [
  { name: "variant", type: '"glyph" | "full"', defaultValue: '"full"', description: "Logo variant. Glyph shows just the dicehub mark, full includes the wordmark." },
  { name: "color", type: '"color" | "black" | "white"', defaultValue: '"color"', description: "Color scheme. Color uses dicehub ink, black and white are solid options." },
  { name: "title", type: "string", defaultValue: '"dicehub logo"', description: "Accessible label for the SVG." },
];

const poweredProps = [
  { name: "color", type: '"color" | "black" | "white"', defaultValue: '"color"', description: "Color scheme for the mark and badge text." },
  { name: "href", type: "string", defaultValue: '"https://dicehub.com"', description: "Link destination." },
  { name: "target", type: "string", defaultValue: '"_blank"', description: "Anchor target." },
  { name: "rel", type: "string", defaultValue: '"noopener noreferrer"', description: "Anchor relationship. Safe external value is applied by default." },
];
---

<DocsLayout title="DicehubLogo" description="Official dicehub logo component with glyph and full logo variants.">
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-copy">
            <CopyPageControls client:only="vue" align="center" />
          </div>

          <div class="docs-page-header__title-row">
            <h1>DicehubLogo</h1>
            <ArkUiDocsLink />
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-copy">
                <CopyPageControls client:only="vue" />
              </div>
              <DocsPageNavigation currentPath={Astro.url.pathname} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">
            Official dicehub logo component with glyph and full logo variants.
          </p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--dicehub-logo">
              <DicehubLogoDocsDemo client:only="vue" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={previewCode} lang="vue" />
            </div>
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>

          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={barrelCode} lang="typescript" />

          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={granularCode} lang="typescript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--dicehub-logo">
              <DicehubLogoDocsDemo client:only="vue" variant="usage" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={usageCode} lang="vue" />
            </div>
          </div>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>

          <h3 id="glyph-only"><a class="docs-section-anchor" href="#glyph-only">Glyph Only</a></h3>
          <p>Use <code>variant="glyph"</code> to display just the dicehub mark without the wordmark.</p>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--dicehub-logo">
              <DicehubLogoDocsDemo client:only="vue" variant="glyph" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={glyphCode} lang="vue" />
            </div>
          </div>

          <h3 id="color-variants"><a class="docs-section-anchor" href="#color-variants">Color Variants</a></h3>
          <p>The logo supports three color schemes: color, black, and white.</p>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--dicehub-logo">
              <DicehubLogoDocsDemo client:only="vue" variant="colors" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={colorVariantsCode} lang="vue" />
            </div>
          </div>

          <h3 id="glyph-color-variants"><a class="docs-section-anchor" href="#glyph-color-variants">Glyph Color Variants</a></h3>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--dicehub-logo">
              <DicehubLogoDocsDemo client:only="vue" variant="glyph-colors" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={glyphVariantsCode} lang="vue" />
            </div>
          </div>

          <h3 id="sizing"><a class="docs-section-anchor" href="#sizing">Sizing</a></h3>
          <p>Size the logo using CSS width. The height adjusts automatically to maintain aspect ratio.</p>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--dicehub-logo">
              <DicehubLogoDocsDemo client:only="vue" variant="sizes" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={sizesCode} lang="vue" />
            </div>
          </div>

          <h3 id="brand-assets-menu"><a class="docs-section-anchor" href="#brand-assets-menu">Brand Assets Menu</a></h3>
          <p>
            Combine with DropdownMenu to create a brand assets menu. Use
            <code>generateDicehubLogoSvg()</code> to get copy-paste ready SVG markup.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--dicehub-logo docs-component-preview--open-space">
              <DicehubLogoDocsDemo client:only="vue" variant="copy" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={copyCode} lang="vue" />
            </div>
          </div>
        </section>

        <section id="powered-by-dicehub" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#powered-by-dicehub">PoweredByDicehub</a></h2>
          <p>A pre-built "Powered by dicehub" badge component for footers and attribution.</p>

          <h3 id="powered-basic-usage"><a class="docs-section-anchor" href="#powered-basic-usage">Basic Usage</a></h3>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--dicehub-logo">
              <DicehubLogoDocsDemo client:only="vue" variant="powered-basic" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={poweredBasicCode} lang="vue" />
            </div>
          </div>

          <h3 id="powered-color-variants"><a class="docs-section-anchor" href="#powered-color-variants">Color Variants</a></h3>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--dicehub-logo">
              <DicehubLogoDocsDemo client:only="vue" variant="powered-variants" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={poweredVariantsCode} lang="vue" />
            </div>
          </div>

          <h3 id="footer-example"><a class="docs-section-anchor" href="#footer-example">Footer Example</a></h3>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--dicehub-logo">
              <DicehubLogoDocsDemo client:only="vue" variant="powered-footer" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={poweredFooterCode} lang="vue" />
            </div>
          </div>
        </section>

        <section id="svg-generation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#svg-generation">SVG Generation</a></h2>
          <p>
            Use <code>generateDicehubLogoSvg()</code> to get copy-paste ready SVG markup for non-Vue contexts.
          </p>
          <CodeBlock code={svgGenerationCode} lang="typescript" />
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <p><code>DicehubLogo</code> renders an SVG and accepts standard SVG attributes.</p>

          <div class="docs-api-group">
            <h3 id="dicehub-logo-api"><a class="docs-section-anchor" href="#dicehub-logo-api">DicehubLogo</a></h3>
            <div class="docs-api-table">
              <table>
                <thead>
                  <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
                </thead>
                <tbody>
                  {logoProps.map((prop) => (
                    <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div class="docs-api-group">
            <h3 id="powered-by-dicehub-api"><a class="docs-section-anchor" href="#powered-by-dicehub-api">PoweredByDicehub</a></h3>
            <p>Extends <code>HTMLAnchorElement</code> and accepts standard anchor attributes.</p>
            <div class="docs-api-table">
              <table>
                <thead>
                  <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
                </thead>
                <tbody>
                  {poweredProps.map((prop) => (
                    <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>
        <DocsPageNavigation currentPath={Astro.url.pathname} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li>
              <a href="#installation">Installation</a>
              <ul>
                <li><a href="#barrel">Barrel</a></li>
                <li><a href="#granular">Granular</a></li>
              </ul>
            </li>
            <li><a href="#usage">Usage</a></li>
            <li>
              <a href="#examples">Examples</a>
              <ul>
                <li><a href="#glyph-only">Glyph Only</a></li>
                <li><a href="#color-variants">Color Variants</a></li>
                <li><a href="#glyph-color-variants">Glyph Color Variants</a></li>
                <li><a href="#sizing">Sizing</a></li>
                <li><a href="#brand-assets-menu">Brand Assets Menu</a></li>
              </ul>
            </li>
            <li>
              <a href="#powered-by-dicehub">PoweredByDicehub</a>
              <ul>
                <li><a href="#powered-basic-usage">Basic Usage</a></li>
                <li><a href="#powered-color-variants">Color Variants</a></li>
                <li><a href="#footer-example">Footer Example</a></li>
              </ul>
            </li>
            <li><a href="#svg-generation">SVG Generation</a></li>
            <li>
              <a href="#api-reference">API Reference</a>
              <ul>
                <li><a href="#dicehub-logo-api">DicehubLogo</a></li>
                <li><a href="#powered-by-dicehub-api">PoweredByDicehub</a></li>
              </ul>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
