---
import CodeBlock from "../../../components/CodeBlock.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import ToastDocsDemo from "../../../components/ToastDocsDemo.vue";
import {
  toastBarrelCode,
  toastExamples,
  toastGranularCode,
  toastManagerCode,
  toastManagerMethods,
  toastOptionsProps,
  toastPreviewCode,
  toastSetupCode,
  toastToastyProps,
  toastUsageCode,
} from "../../../data/toast-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/component-docs.css";

const getDescriptionParts = (description: string) =>
  description.split(/(`[^`]+`)/g).map((part) => ({
    kind: part.startsWith("`") && part.endsWith("`") ? "code" : "text",
    value: part.startsWith("`") && part.endsWith("`") ? part.slice(1, -1) : part,
  }));
---

<DocsLayout title="Toast" description="A notification system for displaying brief, non-intrusive messages to users.">
  <div class="docs-page docs-page--component docs-page--toast">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-copy">
            <CopyPageControls client:only="vue" align="center" />
          </div>

          <div class="docs-page-header__title-row">
            <h1>Toast</h1>
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-copy">
                <CopyPageControls client:only="vue" />
              </div>
              <DocsPageNavigation currentPath={Astro.url.pathname} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">
            A notification system for displaying brief, non-intrusive messages to users.
          </p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--toast">
              <ToastDocsDemo client:only="vue" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={toastPreviewCode} lang="vue" />
            </div>
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>

          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={toastBarrelCode} lang="typescript" />

          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={toastGranularCode} lang="typescript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            The toast system consists of the <code>Toasty</code> provider component and a toast manager. Use
            <code>usePhiToastManager()</code> from provider descendants, or pass a manager from
            <code>createPhiToastManager()</code> when dispatching outside the provider tree.
          </p>
          <CodeBlock code={toastUsageCode} lang="vue" />
        </section>

        <section id="setup" class="docs-section">
          <h2><a class="docs-section-anchor" href="#setup">Setup</a></h2>
          <p>
            Wrap your application or a section of it with the <code>Toasty</code> provider. This sets up the toast context
            and renders the toast viewport.
          </p>
          <CodeBlock code={toastSetupCode} lang="vue" />
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>

          {toastExamples.map((example) => (
            <Fragment>
              <h3 id={example.id}><a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a></h3>
              <p>
                {
                  getDescriptionParts(example.description).map((part) =>
                    part.kind === "code" ? <code>{part.value}</code> : part.value,
                  )
                }
              </p>
              <div class="docs-component-example">
                <div class="docs-component-preview docs-component-preview--toast">
                  <ToastDocsDemo client:only="vue" variant={example.variant} />
                </div>
                <div class="docs-component-example__code">
                  <CodeBlock code={example.code} lang="vue" />
                </div>
              </div>
            </Fragment>
          ))}
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>

          <h3 id="toasty"><a class="docs-section-anchor" href="#toasty">Toasty</a></h3>
          <p>The provider component that wraps your app and manages the toast system.</p>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Prop / Slot</th><th>Type</th><th>Default</th><th>Description</th></tr>
              </thead>
              <tbody>
                {toastToastyProps.map((prop) => (
                  <tr>
                    <td><code>{prop.name}</code></td>
                    <td><code>{prop.type}</code></td>
                    <td><code>{prop.defaultValue}</code></td>
                    <td>
                      {
                        getDescriptionParts(prop.description).map((part) =>
                          part.kind === "code" ? <code>{part.value}</code> : part.value,
                        )
                      }
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 id="use-phi-toast-manager">
            <a class="docs-section-anchor" href="#use-phi-toast-manager">usePhiToastManager()</a>
          </h3>
          <p>A composable that returns the toast manager for creating toasts.</p>
          <CodeBlock code={toastManagerCode} lang="typescript" />

          <h3 id="manager-methods">
            <a class="docs-section-anchor" href="#manager-methods">Manager Methods</a>
          </h3>
          <p>
            <code>update()</code> accepts a partial patch or a callback that receives the current
            <code>PhiToast</code> and returns the patch to merge.
          </p>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Method</th><th>Type</th><th>Description</th></tr>
              </thead>
              <tbody>
                {toastManagerMethods.map((method) => (
                  <tr>
                    <td><code>{method.name}</code></td>
                    <td><code>{method.type}</code></td>
                    <td>
                      {
                        getDescriptionParts(method.description).map((part) =>
                          part.kind === "code" ? <code>{part.value}</code> : part.value,
                        )
                      }
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 id="toast-options"><a class="docs-section-anchor" href="#toast-options">Toast Options</a></h3>
          <p>Options passed to <code>toastManager.add()</code> and promise handlers.</p>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
              </thead>
              <tbody>
                {toastOptionsProps.map((prop) => (
                  <tr>
                    <td><code>{prop.name}</code></td>
                    <td><code>{prop.type}</code></td>
                    <td><code>{prop.defaultValue}</code></td>
                    <td>
                      {
                        getDescriptionParts(prop.description).map((part) =>
                          part.kind === "code" ? <code>{part.value}</code> : part.value,
                        )
                      }
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
        <DocsPageNavigation currentPath={Astro.url.pathname} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li>
              <a href="#installation">Installation</a>
              <ul>
                <li><a href="#barrel">Barrel</a></li>
                <li><a href="#granular">Granular</a></li>
              </ul>
            </li>
            <li><a href="#usage">Usage</a></li>
            <li><a href="#setup">Setup</a></li>
            <li>
              <a href="#examples">Examples</a>
              <ul>
                <li><a href="#title-and-description">Title and Description</a></li>
                <li><a href="#title-only">Title Only</a></li>
                <li><a href="#description-only">Description Only</a></li>
                <li><a href="#success-variant">Success Variant</a></li>
                <li><a href="#multiple-toasts">Multiple Toasts</a></li>
                <li><a href="#error-variant">Error Variant</a></li>
                <li><a href="#warning-variant">Warning Variant</a></li>
                <li><a href="#info-variant">Info Variant</a></li>
                <li><a href="#custom-content">Custom Content</a></li>
                <li><a href="#action-buttons">Action Buttons</a></li>
                <li><a href="#promise">Promise</a></li>
                <li><a href="#update-toast">Update a Toast</a></li>
              </ul>
            </li>
            <li>
              <a href="#api-reference">API Reference</a>
              <ul>
                <li><a href="#toasty">Toasty</a></li>
                <li><a href="#use-phi-toast-manager">usePhiToastManager()</a></li>
                <li><a href="#manager-methods">Manager Methods</a></li>
                <li><a href="#toast-options">Toast Options</a></li>
              </ul>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
