---
import ArkUiDocsLink from "../../../components/ArkUiDocsLink.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import InputGroupDocsDemo from "../../../components/InputGroupDocsDemo.vue";
import {
  inputGroupAddonProps,
  inputGroupBareCode,
  inputGroupBarrelCode,
  inputGroupButtonProps,
  inputGroupErrorTypes,
  inputGroupEvents,
  inputGroupExamples,
  inputGroupGranularCode,
  inputGroupInputProps,
  inputGroupPreviewCode,
  inputGroupRootProps,
  inputGroupSuffixProps,
  inputGroupUsageFieldCode,
} from "../../../data/input-group-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/component-docs.css";
---

<DocsLayout title="InputGroup" description="Compose inputs with addons, icons, buttons, and text for rich form fields.">
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-copy">
            <CopyPageControls client:only="vue" align="center" />
          </div>

          <div class="docs-page-header__title-row">
            <h1>InputGroup</h1>
            <ArkUiDocsLink />
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-copy">
                <CopyPageControls client:only="vue" />
              </div>
              <DocsPageNavigation currentPath={Astro.url.pathname} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">
            Compose inputs with addons, icons, buttons, and text for rich form fields.
          </p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--input-group">
              <InputGroupDocsDemo client:only="vue" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={inputGroupPreviewCode} lang="vue" />
            </div>
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>

          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={inputGroupBarrelCode} lang="typescript" />

          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={inputGroupGranularCode} lang="typescript" />
        </section>

        <section id="usage" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>

          <h3 id="with-built-in-field-recommended">
            <a class="docs-section-anchor" href="#with-built-in-field-recommended">With Built-in Field (Recommended)</a>
          </h3>
          <p>
            Pass the <code>label</code> prop to InputGroup to enable the built-in Field wrapper with
            label, description, and error support.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--input-group">
              <InputGroupDocsDemo client:only="vue" variant="field" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={inputGroupUsageFieldCode} lang="vue" />
            </div>
          </div>

          <h3 id="bare-inputgroup-custom-layouts">
            <a class="docs-section-anchor" href="#bare-inputgroup-custom-layouts">Bare InputGroup (Custom Layouts)</a>
          </h3>
          <p>
            For custom form layouts, use InputGroup without <code>label</code>. Must provide
            <code>aria-label</code> or <code>aria-labelledby</code> on InputGroup.Input for accessibility.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--input-group">
              <InputGroupDocsDemo client:only="vue" variant="bare" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={inputGroupBareCode} lang="vue" />
            </div>
          </div>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>

          {
            inputGroupExamples.map((example) => (
              <>
                <h3 id={example.id}>
                  <a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a>
                </h3>
                <p>{example.description}</p>
                <div class="docs-component-example">
                  <div class="docs-component-preview docs-component-preview--input-group">
                    <InputGroupDocsDemo client:only="vue" variant={example.variant} />
                  </div>
                  <div class="docs-component-example__code">
                    <CodeBlock code={example.code} lang="vue" />
                  </div>
                </div>
              </>
            ))
          }
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>

          <h3 id="inputgroup"><a class="docs-section-anchor" href="#inputgroup">InputGroup</a></h3>
          <p>The root container that provides context to all child parts.</p>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
              </thead>
              <tbody>
                {inputGroupRootProps.map((prop) => (
                  <tr>
                    <td><code>{prop.name}</code></td>
                    <td><code>{prop.type}</code></td>
                    <td><code>{prop.defaultValue}</code></td>
                    <td>{prop.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 id="inputgroupinput"><a class="docs-section-anchor" href="#inputgroupinput">InputGroup.Input</a></h3>
          <p>The text input element. It inherits size, disabled, label, and error context from InputGroup.</p>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
              </thead>
              <tbody>
                {inputGroupInputProps.map((prop) => (
                  <tr>
                    <td><code>{prop.name}</code></td>
                    <td><code>{prop.type}</code></td>
                    <td><code>{prop.defaultValue}</code></td>
                    <td>{prop.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 id="inputgroupaddon"><a class="docs-section-anchor" href="#inputgroupaddon">InputGroup.Addon</a></h3>
          <p>Container for icons, text, or compact buttons positioned at the start or end of the input.</p>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
              </thead>
              <tbody>
                {inputGroupAddonProps.map((prop) => (
                  <tr>
                    <td><code>{prop.name}</code></td>
                    <td><code>{prop.type}</code></td>
                    <td><code>{prop.defaultValue}</code></td>
                    <td>{prop.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 id="inputgroupbutton"><a class="docs-section-anchor" href="#inputgroupbutton">InputGroup.Button</a></h3>
          <p>Button for secondary actions like toggle, clear, or help.</p>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
              </thead>
              <tbody>
                {inputGroupButtonProps.map((prop) => (
                  <tr>
                    <td><code>{prop.name}</code></td>
                    <td><code>{prop.type}</code></td>
                    <td><code>{prop.defaultValue}</code></td>
                    <td>{prop.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 id="inputgroupsuffix"><a class="docs-section-anchor" href="#inputgroupsuffix">InputGroup.Suffix</a></h3>
          <p>Inline text that flows seamlessly next to the typed value.</p>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
              </thead>
              <tbody>
                {inputGroupSuffixProps.map((prop) => (
                  <tr>
                    <td><code>{prop.name}</code></td>
                    <td><code>{prop.type}</code></td>
                    <td><code>{prop.defaultValue}</code></td>
                    <td>{prop.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 id="events"><a class="docs-section-anchor" href="#events">Events</a></h3>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Event</th><th>Type</th><th>Description</th></tr>
              </thead>
              <tbody>
                {inputGroupEvents.map((event) => (
                  <tr>
                    <td><code>{event.name}</code></td>
                    <td><code>{event.type}</code></td>
                    <td>{event.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 id="validation-error-types">
            <a class="docs-section-anchor" href="#validation-error-types">Validation Error Types</a>
          </h3>
          <p>Structured errors accept a browser validity match key.</p>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Match</th></tr>
              </thead>
              <tbody>
                {inputGroupErrorTypes.map((type) => (
                  <tr><td><code>{type}</code></td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>

          <h3 id="label-requirement"><a class="docs-section-anchor" href="#label-requirement">Label Requirement</a></h3>
          <p>
            Prefer the <code>label</code> prop on InputGroup. For bare groups, provide
            <code>aria-label</code> or <code>aria-labelledby</code> on <code>InputGroup.Input</code>.
          </p>

          <h3 id="group-role"><a class="docs-section-anchor" href="#group-role">Group Role</a></h3>
          <p>
            InputGroup renders with <code>role="group"</code> to associate the input with its addons for assistive technologies.
          </p>
        </section>
        <DocsPageNavigation currentPath={Astro.url.pathname} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li>
              <a href="#installation">Installation</a>
              <ul>
                <li><a href="#barrel">Barrel</a></li>
                <li><a href="#granular">Granular</a></li>
              </ul>
            </li>
            <li>
              <a href="#usage">Usage</a>
              <ul>
                <li><a href="#with-built-in-field-recommended">With Built-in Field (Recommended)</a></li>
                <li><a href="#bare-inputgroup-custom-layouts">Bare InputGroup (Custom Layouts)</a></li>
              </ul>
            </li>
            <li>
              <a href="#examples">Examples</a>
              <ul>
                {inputGroupExamples.map((example) => <li><a href={`#${example.id}`}>{example.title}</a></li>)}
              </ul>
            </li>
            <li>
              <a href="#api-reference">API Reference</a>
              <ul>
                <li><a href="#inputgroup">InputGroup</a></li>
                <li><a href="#inputgroupinput">InputGroup.Input</a></li>
                <li><a href="#inputgroupaddon">InputGroup.Addon</a></li>
                <li><a href="#inputgroupbutton">InputGroup.Button</a></li>
                <li><a href="#inputgroupsuffix">InputGroup.Suffix</a></li>
                <li><a href="#events">Events</a></li>
                <li><a href="#validation-error-types">Validation Error Types</a></li>
              </ul>
            </li>
            <li>
              <a href="#accessibility">Accessibility</a>
              <ul>
                <li><a href="#label-requirement">Label Requirement</a></li>
                <li><a href="#group-role">Group Role</a></li>
              </ul>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
