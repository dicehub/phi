---
import ArkUiDocsLink from "../../../components/ArkUiDocsLink.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import SwitchDocsDemo from "../../../components/SwitchDocsDemo.vue";
import { switchAccessibilityRows, switchApiSections } from "../../../data/switch-api-docs";
import {
  switchBarrelCode,
  switchExamples,
  switchGranularCode,
  switchPreviewCode,
  switchUsageCode,
} from "../../../data/switch-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/component-docs.css";

const getDescriptionParts = (description: string) =>
  description.split(/(`[^`]+`)/g).map((part) => ({
    kind: part.startsWith("`") && part.endsWith("`") ? "code" : "text",
    value: part.startsWith("`") && part.endsWith("`") ? part.slice(1, -1) : part,
  }));
---

<DocsLayout title="Switch" description="A two-state button that can be either on or off.">
  <div class="docs-page docs-page--component docs-page--switch">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-copy">
            <CopyPageControls client:only="vue" align="center" />
          </div>

          <div class="docs-page-header__title-row">
            <h1>Switch</h1>
            <ArkUiDocsLink />
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-copy">
                <CopyPageControls client:only="vue" />
              </div>
              <DocsPageNavigation currentPath={Astro.url.pathname} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">
            A two-state button that can be either on or off.
          </p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--switch">
              <SwitchDocsDemo client:only="vue" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={switchPreviewCode} lang="vue" />
            </div>
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>

          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={switchBarrelCode} lang="typescript" />

          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={switchGranularCode} lang="typescript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <CodeBlock code={switchUsageCode} lang="vue" />
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>

          {
            switchExamples.map((example) => (
              <>
                <h3 id={example.id}><a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a></h3>
                <p>
                  {
                    getDescriptionParts(example.description).map((part) =>
                      part.kind === "code" ? <code>{part.value}</code> : part.value,
                    )
                  }
                </p>
                <div class="docs-component-example">
                  <div class="docs-component-preview docs-component-preview--switch">
                    <SwitchDocsDemo client:only="vue" variant={example.variant} />
                  </div>
                  <div class="docs-component-example__code">
                    <CodeBlock code={example.code} lang="vue" />
                  </div>
                </div>
              </>
            ))
          }
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>

          {
            switchApiSections.map((section) => (
              <>
                <h3 id={section.id}><a class="docs-section-anchor" href={`#${section.id}`}>{section.title}</a></h3>
                <p>
                  {
                    getDescriptionParts(section.description).map((part) =>
                      part.kind === "code" ? <code>{part.value}</code> : part.value,
                    )
                  }
                </p>
                <div class="docs-api-table">
                  <table>
                    <thead>
                      <tr><th>Prop / Event</th><th>Type</th><th>Default</th><th>Description</th></tr>
                    </thead>
                    <tbody>
                      {section.rows.map((prop) => (
                        <tr>
                          <td><code>{prop.name}</code></td>
                          <td><code>{prop.type}</code></td>
                          <td><code>{prop.defaultValue}</code></td>
                          <td>
                            {
                              getDescriptionParts(prop.description).map((part) =>
                                part.kind === "code" ? <code>{part.value}</code> : part.value,
                              )
                            }
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </>
            ))
          }
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <div class="docs-accessibility-list">
            {
              switchAccessibilityRows.map((row) => (
                <div class="docs-accessibility-list__item">
                  <h3>{row.title}</h3>
                  <p>
                    {
                      getDescriptionParts(row.description).map((part) =>
                        part.kind === "code" ? <code>{part.value}</code> : part.value,
                      )
                    }
                  </p>
                </div>
              ))
            }
          </div>
        </section>
        <DocsPageNavigation currentPath={Astro.url.pathname} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li>
              <a href="#installation">Installation</a>
              <ul>
                <li><a href="#barrel">Barrel</a></li>
                <li><a href="#granular">Granular</a></li>
              </ul>
            </li>
            <li><a href="#usage">Usage</a></li>
            <li>
              <a href="#examples">Examples</a>
              <ul>
                {switchExamples.map((example) => <li><a href={`#${example.id}`}>{example.title}</a></li>)}
              </ul>
            </li>
            <li>
              <a href="#api-reference">API Reference</a>
              <ul>
                {switchApiSections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}
              </ul>
            </li>
            <li><a href="#accessibility">Accessibility</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
