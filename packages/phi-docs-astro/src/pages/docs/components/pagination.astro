---
import CodeBlock from "../../../components/CodeBlock.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import PaginationDocsDemo from "../../../components/PaginationDocsDemo.vue";
import {
  paginationBarrelCode,
  paginationCompoundApi,
  paginationCompoundExamples,
  paginationExamples,
  paginationGranularCode,
  paginationI18nCode,
  paginationPreviewCode,
  paginationRootProps,
  paginationUsageCode,
} from "../../../data/pagination-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/component-docs.css";
---

<DocsLayout title="Pagination" description="A page navigation component for navigating through paginated content.">
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-copy">
            <CopyPageControls client:only="vue" align="center" />
          </div>

          <div class="docs-page-header__title-row">
            <h1>Pagination</h1>
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-copy">
                <CopyPageControls client:only="vue" />
              </div>
              <DocsPageNavigation currentPath={Astro.url.pathname} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">
            A page navigation component for navigating through paginated content.
          </p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--pagination">
              <PaginationDocsDemo client:only="vue" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={paginationPreviewCode} lang="vue" />
            </div>
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>

          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={paginationBarrelCode} lang="typescript" />

          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={paginationGranularCode} lang="typescript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <CodeBlock code={paginationUsageCode} lang="vue" />
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>

          {
            paginationExamples.map((example) => (
              <>
                <h3 id={example.id}><a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a></h3>
                <p>{example.description}</p>
                <div class="docs-component-example">
                  <div class="docs-component-preview docs-component-preview--pagination">
                    <PaginationDocsDemo client:only="vue" variant={example.variant} />
                  </div>
                  <div class="docs-component-example__code">
                    <CodeBlock code={example.code} lang="vue" />
                  </div>
                </div>
              </>
            ))
          }
        </section>

        <section id="compound-components" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#compound-components">Compound Components</a></h2>
          <p>
            For more control over layout and features, compose <code>Pagination.Info</code>,
            <code>Pagination.PageSize</code>, <code>Pagination.Controls</code>, and
            <code>Pagination.Separator</code> in any order.
          </p>

          {
            paginationCompoundExamples.map((example) => (
              <>
                <h3 id={example.id}><a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a></h3>
                <p>{example.description}</p>
                <div class="docs-component-example">
                  <div class="docs-component-preview docs-component-preview--pagination">
                    <PaginationDocsDemo client:only="vue" variant={example.variant} />
                  </div>
                  <div class="docs-component-example__code">
                    <CodeBlock code={example.code} lang="vue" />
                  </div>
                </div>
              </>
            ))
          }
        </section>

        <section id="internationalization" class="docs-section">
          <h2><a class="docs-section-anchor" href="#internationalization">Internationalization</a></h2>
          <p>
            Use the <code>labels</code> prop to customize aria labels. Visible text is customized
            with <code>Pagination.Info</code> scoped slots.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--pagination">
              <PaginationDocsDemo client:only="vue" variant="i18n" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={paginationI18nCode} lang="vue" />
            </div>
          </div>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
              </thead>
              <tbody>
                {paginationRootProps.map((prop) => (
                  <tr>
                    <td><code>{prop.name}</code></td>
                    <td><code>{prop.type}</code></td>
                    <td><code>{prop.defaultValue}</code></td>
                    <td>{prop.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 id="compound-api"><a class="docs-section-anchor" href="#compound-api">Compound API</a></h3>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Component</th><th>Prop / Event</th><th>Type</th><th>Default</th><th>Description</th></tr>
              </thead>
              <tbody>
                {paginationCompoundApi.map((prop) => (
                  <tr>
                    <td><code>{prop.component}</code></td>
                    <td><code>{prop.prop}</code></td>
                    <td><code>{prop.type}</code></td>
                    <td><code>{prop.defaultValue}</code></td>
                    <td>{prop.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
        <DocsPageNavigation currentPath={Astro.url.pathname} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li>
              <a href="#installation">Installation</a>
              <ul>
                <li><a href="#barrel">Barrel</a></li>
                <li><a href="#granular">Granular</a></li>
              </ul>
            </li>
            <li><a href="#usage">Usage</a></li>
            <li>
              <a href="#examples">Examples</a>
              <ul>
                {paginationExamples.map((example) => <li><a href={`#${example.id}`}>{example.title}</a></li>)}
              </ul>
            </li>
            <li>
              <a href="#compound-components">Compound Components</a>
              <ul>
                {paginationCompoundExamples.map((example) => <li><a href={`#${example.id}`}>{example.title}</a></li>)}
              </ul>
            </li>
            <li><a href="#internationalization">Internationalization</a></li>
            <li>
              <a href="#api-reference">API Reference</a>
              <ul>
                <li><a href="#compound-api">Compound API</a></li>
              </ul>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
