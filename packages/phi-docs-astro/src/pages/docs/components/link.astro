---
import CodeBlock from "../../../components/CodeBlock.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import LinkDocsDemo from "../../../components/LinkDocsDemo.vue";
import {
  linkBarrelCode,
  linkCompositionCode,
  linkExamples,
  linkExternalCode,
  linkFrameworkCode,
  linkGranularCode,
  linkGuidelines,
  linkPreviewCode,
  linkProps,
  linkUsageCode,
  linkVariantRows,
} from "../../../data/link-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/component-docs.css";
---

<DocsLayout title="Link" description="A styled anchor component for inline text links with multiple variants and external-link indicators.">
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-copy">
            <CopyPageControls client:only="vue" align="center" />
          </div>

          <div class="docs-page-header__title-row">
            <h1>Link</h1>
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-copy">
                <CopyPageControls client:only="vue" />
              </div>
              <DocsPageNavigation currentPath={Astro.url.pathname} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">
            A styled anchor component for inline text links with multiple variants and external-link indicators.
          </p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--link">
              <LinkDocsDemo client:only="vue" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={linkPreviewCode} lang="vue" />
            </div>
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>

          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={linkBarrelCode} lang="typescript" />

          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={linkGranularCode} lang="typescript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>

          <h3 id="basic-link"><a class="docs-section-anchor" href="#basic-link">Basic Link</a></h3>
          <p>
            The default Link renders an underlined anchor with primary link color styling.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--link">
              <LinkDocsDemo client:only="vue" variant="usage" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={linkUsageCode} lang="vue" />
            </div>
          </div>

          <h3 id="external-links"><a class="docs-section-anchor" href="#external-links">External Links</a></h3>
          <p>
            Use <code>Link.ExternalIcon</code> to indicate links that open in a new tab.
          </p>
          <CodeBlock code={linkExternalCode} lang="vue" />

          <h3 id="framework-integration"><a class="docs-section-anchor" href="#framework-integration">Framework Integration</a></h3>
          <p>
            Routing behavior belongs to the application. Compose Link with your router's custom link slot when client-side navigation is required.
          </p>
          <CodeBlock code={linkFrameworkCode} lang="vue" />

          <h3 id="composition-with-routerlink"><a class="docs-section-anchor" href="#composition-with-routerlink">Composition with RouterLink</a></h3>
          <CodeBlock code={linkCompositionCode} lang="vue" />
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>

          {
            linkExamples.map((example) => (
              <>
                <h3 id={example.id}><a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a></h3>
                <p>{example.description}</p>
                <div class="docs-component-example">
                  <div class="docs-component-preview docs-component-preview--link">
                    <LinkDocsDemo client:only="vue" variant={example.variant} />
                  </div>
                  <div class="docs-component-example__code">
                    <CodeBlock code={example.code} lang="vue" />
                  </div>
                </div>
              </>
            ))
          }
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>

          <h3 id="link-props"><a class="docs-section-anchor" href="#link-props">Link Props</a></h3>
          <p>Extends native anchor element attributes.</p>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
              </thead>
              <tbody>
                {linkProps.map((prop) => (
                  <tr>
                    <td><code>{prop.name}</code></td>
                    <td><code>{prop.type}</code></td>
                    <td><code>{prop.defaultValue}</code></td>
                    <td>{prop.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 id="variants"><a class="docs-section-anchor" href="#variants">Variants</a></h3>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Variant</th><th>Description</th><th>Use Case</th></tr>
              </thead>
              <tbody>
                {linkVariantRows.map((row) => (
                  <tr>
                    <td><code>{row.name}</code></td>
                    <td>{row.description}</td>
                    <td>{row.useCase}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <h3 id="link-external-icon"><a class="docs-section-anchor" href="#link-external-icon">Link.ExternalIcon</a></h3>
          <p>
            SVG icon component to indicate external links. It accepts standard SVG attributes and is hidden from assistive technology.
          </p>
        </section>

        <section id="design-guidelines" class="docs-section">
          <h2><a class="docs-section-anchor" href="#design-guidelines">Design Guidelines</a></h2>
          {
            linkGuidelines.map((guideline) => (
              <>
                <h3 id={guideline.id}><a class="docs-section-anchor" href={`#${guideline.id}`}>{guideline.title}</a></h3>
                <p>{guideline.body}</p>
              </>
            ))
          }
        </section>
        <DocsPageNavigation currentPath={Astro.url.pathname} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li>
              <a href="#installation">Installation</a>
              <ul>
                <li><a href="#barrel">Barrel</a></li>
                <li><a href="#granular">Granular</a></li>
              </ul>
            </li>
            <li>
              <a href="#usage">Usage</a>
              <ul>
                <li><a href="#basic-link">Basic Link</a></li>
                <li><a href="#external-links">External Links</a></li>
                <li><a href="#framework-integration">Framework Integration</a></li>
                <li><a href="#composition-with-routerlink">Composition with RouterLink</a></li>
              </ul>
            </li>
            <li>
              <a href="#examples">Examples</a>
              <ul>
                {linkExamples.map((example) => <li><a href={`#${example.id}`}>{example.title}</a></li>)}
              </ul>
            </li>
            <li>
              <a href="#api-reference">API Reference</a>
              <ul>
                <li><a href="#link-props">Link Props</a></li>
                <li><a href="#variants">Variants</a></li>
                <li><a href="#link-external-icon">Link.ExternalIcon</a></li>
              </ul>
            </li>
            <li>
              <a href="#design-guidelines">Design Guidelines</a>
              <ul>
                {linkGuidelines.map((guideline) => <li><a href={`#${guideline.id}`}>{guideline.title}</a></li>)}
              </ul>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
