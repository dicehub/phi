---
import ChartMapDocsDemo from "../../../components/ChartMapDocsDemo.vue";
import CodeBlock from "../../../components/CodeBlock.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import { chartInstallCode, choroplethMapProps, choroplethMapUsageCode, mapProps, mapUsageCode } from "../../../data/chart-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/component-docs.css";

const mapBarrelCode = `import { BubbleMap, ChoroplethMap, type MapGeoJson } from "@dicehub/phi";`;
const mapGranularCode = `import { BubbleMap, ChoroplethMap, type MapGeoJson } from "@dicehub/phi/components/chart";`;
const mapPreviewCode = `<script setup lang="ts">
const cloudflareLocations = [
  { city: "San Francisco", iata: "SFO", lat: 37.77, lon: -122.42 },
  { city: "London", iata: "LHR", lat: 51.51, lon: -0.13 },
  { city: "Singapore", iata: "SIN", lat: 1.35, lon: 103.82 },
  // ...more locations
];
</script>

<template>
  <BubbleMap
    :echarts="echarts"
    :geo-json="geoJson"
    :data="cloudflareLocations"
    lng="lon"
    lat="lat"
    name="city"
    :value="() => 1"
    bubble-color="#F6821F"
    :min-radius="8"
    :max-radius="8"
    :tooltip-formatter="(row) =>
      '<strong>' + row.city + '</strong> ' + row.iata
    "
  />
</template>`;
const mapExampleCode = `<BubbleMap
  :echarts="echarts"
  :geo-json="geoJson"
  :data="colos"
  lng="lon"
  lat="lat"
  name="city"
  value="requests"
  :min-radius="8"
/>`;
const customTooltipCode = `<BubbleMap
  :echarts="echarts"
  :geo-json="geoJson"
  :data="colos"
  lng="lon"
  lat="lat"
  name="city"
  value="requests"
  :tooltip-formatter="(row) =>
    '<strong>' + row.city + '</strong><br />' + row.requests.toLocaleString()
  "
/>`;
const choroplethMapCode = `<ChoroplethMap
  :echarts="echarts"
  :geo-json="geoJson"
  :data="countries"
  name="country"
  value="requests"
/>`;
---

<DocsLayout title="Maps" description="Map chart components for visualizing geographic data with GeoJSON.">
  <div class="docs-page docs-page--component docs-page--charts">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-copy">
            <CopyPageControls client:only="vue" align="center" />
          </div>
          <div class="docs-page-header__title-row">
            <h1>Maps</h1>
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-copy">
                <CopyPageControls client:only="vue" />
              </div>
              <DocsPageNavigation currentPath={Astro.url.pathname} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">Map chart components for visualizing geographic data with GeoJSON.</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--chart">
              <ChartMapDocsDemo client:only="vue" variant="preview" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={mapPreviewCode} lang="vue" />
            </div>
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <p>Map charts require ECharts. Consumers provide GeoJSON; components do not fetch map data or tiles.</p>
          <CodeBlock code={chartInstallCode} lang="bash" />

          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={mapBarrelCode} lang="typescript" />

          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={mapGranularCode} lang="typescript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <h3 id="bubble-map-usage"><a class="docs-section-anchor" href="#bubble-map-usage">BubbleMap</a></h3>
          <CodeBlock code={mapUsageCode} lang="vue" />
          <h3 id="choropleth-map-usage"><a class="docs-section-anchor" href="#choropleth-map-usage">ChoroplethMap</a></h3>
          <CodeBlock code={choroplethMapUsageCode} lang="vue" />
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>
          <h3 id="bubble-map"><a class="docs-section-anchor" href="#bubble-map">Bubble Map</a></h3>
          <p>Plot raw rows by longitude and latitude.</p>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--chart">
              <ChartMapDocsDemo client:only="vue" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={mapExampleCode} lang="vue" />
            </div>
          </div>
          <h3 id="choropleth-map"><a class="docs-section-anchor" href="#choropleth-map">Choropleth Map</a></h3>
          <p>Join rows to GeoJSON regions and shade each region by value.</p>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--chart">
              <ChartMapDocsDemo client:only="vue" variant="choropleth" />
            </div>
            <div class="docs-component-example__code">
              <CodeBlock code={choroplethMapCode} lang="vue" />
            </div>
          </div>
          <h3 id="custom-tooltips"><a class="docs-section-anchor" href="#custom-tooltips">Custom Tooltips</a></h3>
          <p>Provide <code>tooltipFormatter</code> when the default name/value tooltip is not enough. The formatter returns HTML rendered by ECharts, so escape user-provided values.</p>
          <CodeBlock code={customTooltipCode} lang="vue" />
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <h3 id="bubble-map-api"><a class="docs-section-anchor" href="#bubble-map-api">BubbleMap</a></h3>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
              </thead>
              <tbody>
                {mapProps.map((prop) => (
                  <tr>
                    <td><code>{prop.name}</code></td>
                    <td><code>{prop.type}</code></td>
                    <td><code>{prop.defaultValue}</code></td>
                    <td>{prop.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <h3 id="choropleth-map-api"><a class="docs-section-anchor" href="#choropleth-map-api">ChoroplethMap</a></h3>
          <div class="docs-api-table">
            <table>
              <thead>
                <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
              </thead>
              <tbody>
                {choroplethMapProps.map((prop) => (
                  <tr>
                    <td><code>{prop.name}</code></td>
                    <td><code>{prop.type}</code></td>
                    <td><code>{prop.defaultValue}</code></td>
                    <td>{prop.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
        <DocsPageNavigation currentPath={Astro.url.pathname} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li>
              <a href="#installation">Installation</a>
              <ul>
                <li><a href="#barrel">Barrel</a></li>
                <li><a href="#granular">Granular</a></li>
              </ul>
            </li>
            <li><a href="#usage">Usage</a></li>
            <li>
              <a href="#examples">Examples</a>
              <ul>
                <li><a href="#bubble-map">Bubble Map</a></li>
                <li><a href="#choropleth-map">Choropleth Map</a></li>
                <li><a href="#custom-tooltips">Custom Tooltips</a></li>
              </ul>
            </li>
            <li>
              <a href="#api-reference">API Reference</a>
              <ul>
                <li><a href="#bubble-map-api">BubbleMap</a></li>
                <li><a href="#choropleth-map-api">ChoroplethMap</a></li>
              </ul>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
