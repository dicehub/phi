---
import { ClientRouter } from "astro:transitions";
import { componentRegistry } from "@dicehub/phi/registry";
import DocsSidebar from "../components/DocsSidebar.astro";
import DocsSearchDialog from "../components/DocsSearchDialog.vue";
import DocsTableOfContentsTracker from "../components/DocsTableOfContentsTracker.vue";
import ArkUiDocsLink from "../components/ArkUiDocsLink.astro";
import PhiMark from "../components/PhiMark.astro";
import "../styles/docs.css";
import "../styles/docs-pagination.css";

const frontmatter = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? frontmatter.title ?? "Home";
const description =
  Astro.props.description ??
  frontmatter.description ??
  "Vue components, APIs, and usage guidance for Phi UI.";
const pathname = Astro.url.pathname;
const pageTitle = title === "Home" ? "Phi" : "Phi / " + title;
const showHeaderTitle = title !== "Home";
const showHeaderSourceIcon = Boolean(Astro.props.headerSourceIcon);
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL?.trim();
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim();
---

<html lang="en" class="phi-docs-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="/phi-mark.svg"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/phi-mark-white.svg"
      media="(prefers-color-scheme: dark)"
    />
    <ClientRouter />
    {umamiScriptUrl && umamiWebsiteId && (
      <script
        is:inline
        defer
        id="phi-analytics"
        src={umamiScriptUrl}
        data-website-id={umamiWebsiteId}
        data-domains="phi-ui.com,www.phi-ui.com"
        data-auto-track="false"
        data-exclude-search="true"
        data-exclude-hash="true"
      ></script>
    )}
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const mode = stored === "dark" || stored === "light" ? stored : "light";
        document.documentElement.setAttribute("data-mode", mode);
        document.documentElement.style.colorScheme = mode;
      })();
    </script>
  </head>
  <body>
    <div
      class="docs-app"
      data-docs-app
      data-sidebar-open="true"
      data-mobile-sidebar-open="false"
    >
      <div class="docs-navigation-shell" transition:persist>
        <header class="docs-mobile-header">
          <button
            class="docs-icon-button"
            type="button"
            aria-label="Open menu"
            data-mobile-sidebar-toggle
          >
            <PhiMark class="docs-mark docs-mark--button" title="Phi" />
          </button>
          <span class="docs-mobile-header__title">Phi</span>
          <button class="docs-theme-toggle" type="button" aria-label="Toggle theme" data-theme-toggle>
            <svg
              class="docs-theme-toggle__icon docs-theme-toggle__icon--sun"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
              <path
                d="M12 2.75V5.25M12 18.75V21.25M21.25 12H18.75M5.25 12H2.75M18.54 5.46L16.77 7.23M7.23 16.77L5.46 18.54M18.54 18.54L16.77 16.77M7.23 7.23L5.46 5.46"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
            <svg
              class="docs-theme-toggle__icon docs-theme-toggle__icon--moon"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M14.72 3.23C12.5 4.16 10.94 6.34 10.94 8.89C10.94 12.27 13.68 15.01 17.06 15.01C18.06 15.01 19 14.77 19.84 14.35C18.82 17.81 15.62 20.34 11.83 20.34C7.22 20.34 3.48 16.6 3.48 11.99C3.48 8.12 6.12 4.87 9.68 3.92C10.45 3.72 11.29 3.59 12.16 3.59C13.04 3.59 13.9 3.73 14.72 3.23Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </header>

        <div class="docs-rail">
          <a class="docs-rail__brand" href="/docs" aria-label="Phi home">
            <PhiMark class="docs-mark docs-mark--button" title="Phi" />
          </a>
          <button
            class="docs-sidebar-collapse"
            type="button"
            aria-label="Collapse navigation"
            aria-pressed="true"
            data-sidebar-toggle
          >
            <svg
              class="docs-sidebar-collapse__icon docs-sidebar-collapse__icon--collapse"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M15 6L9 12L15 18"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <svg
              class="docs-sidebar-collapse__icon docs-sidebar-collapse__icon--expand"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M9 6L15 12L9 18"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>

        <div class="docs-desktop-brand">
          <a class="docs-desktop-brand__link" href="/docs">Phi</a>
        </div>

        <DocsSidebar pathname={pathname} variant="mobile" />
        <button
          class="docs-backdrop"
          type="button"
          aria-label="Close menu"
          data-mobile-sidebar-close
        >
        </button>
        <DocsSidebar pathname={pathname} variant="desktop" />
        <DocsSearchDialog client:only="vue" />
      </div>

      <div class="docs-main-shell">
        <header class="docs-header">
          {
            showHeaderTitle && (
              <div class="docs-header__page-title" data-docs-scroll-title>
                <span class="docs-header__page-title-text">{title}</span>
                {
                  showHeaderSourceIcon ? (
                    <span class="docs-header__source-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor">
                        <path d="M216,104v8a56.06,56.06,0,0,1-48.44,55.47A39.8,39.8,0,0,1,176,192v40a8,8,0,0,1-8,8H104a8,8,0,0,1-8-8V216H72a40,40,0,0,1-40-40A24,24,0,0,0,8,152a8,8,0,0,1,0-16,40,40,0,0,1,40,40,24,24,0,0,0,24,24H96v-8a39.8,39.8,0,0,1,8.44-24.53A56.06,56.06,0,0,1,56,112v-8a58.14,58.14,0,0,1,7.69-28.32A59.78,59.78,0,0,1,69.07,28,8,8,0,0,1,76,24a59.75,59.75,0,0,1,48,24h24a59.75,59.75,0,0,1,48-24,8,8,0,0,1,6.93,4,59.74,59.74,0,0,1,5.37,47.68A58,58,0,0,1,216,104Z" />
                      </svg>
                    </span>
                  ) : (
                    <ArkUiDocsLink className="docs-header__primitive-link" size={20} />
                  )
                }
              </div>
            )
          }
          <div class="docs-header__meta">
            <span class="docs-header__package">{componentRegistry.package.name}</span>
            <span class="docs-header__version">v{componentRegistry.package.version}</span>
          </div>
          <div class="docs-header__actions">
            <button class="docs-theme-toggle" type="button" aria-label="Toggle theme" data-theme-toggle>
              <svg
                class="docs-theme-toggle__icon docs-theme-toggle__icon--sun"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
                <path
                  d="M12 2.75V5.25M12 18.75V21.25M21.25 12H18.75M5.25 12H2.75M18.54 5.46L16.77 7.23M7.23 16.77L5.46 18.54M18.54 18.54L16.77 16.77M7.23 7.23L5.46 5.46"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
              </svg>
              <svg
                class="docs-theme-toggle__icon docs-theme-toggle__icon--moon"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path
                  d="M14.72 3.23C12.5 4.16 10.94 6.34 10.94 8.89C10.94 12.27 13.68 15.01 17.06 15.01C18.06 15.01 19 14.77 19.84 14.35C18.82 17.81 15.62 20.34 11.83 20.34C7.22 20.34 3.48 16.6 3.48 11.99C3.48 8.12 6.12 4.87 9.68 3.92C10.45 3.72 11.29 3.59 12.16 3.59C13.04 3.59 13.9 3.73 14.72 3.23Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>
        </header>

        <main class="docs-main">
          <div class="docs-content-frame">
            <slot />
          </div>
        </main>
      </div>
    </div>

    <DocsTableOfContentsTracker client:only="vue" />

    <script>
      import "../scripts/docs-shell";
      import "../scripts/docs-analytics";
    </script>
  </body>
</html>
