---
import { Code } from "astro:components";

interface Props {
  code: string;
  lang?: "astro" | "bash" | "shell" | "tsx" | "ts" | "typescript" | "jsx" | "js" | "javascript" | "vue" | "css" | "json" | "html";
}

const { code, lang = "tsx" } = Astro.props;
---

<div class="docs-code-block" data-code-block>
  <Code
    code={code}
    lang={lang}
    themes={{ light: "github-light", dark: "github-dark" }}
    defaultColor={false}
  />
  <button
    type="button"
    class="docs-code-copy"
    aria-label="Copy code"
    data-code-copy
  >
    <svg class="docs-code-copy__icon docs-code-copy__icon--copy" width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
      <path d="M184,64H40a8,8,0,0,0-8,8V216a8,8,0,0,0,8,8H184a8,8,0,0,0,8-8V72A8,8,0,0,0,184,64Zm-8,144H48V80H176ZM224,40V184a8,8,0,0,1-16,0V48H72a8,8,0,0,1,0-16H216A8,8,0,0,1,224,40Z" />
    </svg>
    <svg class="docs-code-copy__icon docs-code-copy__icon--done" width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
      <path d="M229.66,77.66l-128,128a8,8,0,0,1-11.32,0l-56-56a8,8,0,0,1,11.32-11.32L96,188.69,218.34,66.34a8,8,0,0,1,11.32,11.32Z" />
    </svg>
  </button>
</div>

<script>
  if (!document.documentElement.dataset.docsCodeCopyReady) {
    document.documentElement.dataset.docsCodeCopyReady = "true";
    document.addEventListener("click", async (event) => {
      const btn = event.target instanceof Element ? event.target.closest("[data-code-copy]") : null;
      if (!btn) return;

      const block = btn.closest("[data-code-block]");
      const pre = block?.querySelector("pre");
      if (!pre) return;

      const code = pre.querySelector("code")?.textContent ?? pre.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        btn.classList.add("docs-code-copy--done");
        window.setTimeout(() => btn.classList.remove("docs-code-copy--done"), 1500);
      } catch {}
    });
  }
</script>
