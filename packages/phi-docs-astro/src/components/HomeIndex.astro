---
import { navGroups } from "../data/docs-nav";
import "../styles/home-index.css";

const groups = navGroups.map((group) => ({
  ...group,
  id: `home-${group.label.toLowerCase()}`,
  links: [...group.links].sort((a, b) => a.label.localeCompare(b.label, "en", { sensitivity: "base" })),
}));
---

<div class="home-index">
  <header class="docs-page-header">
    <div class="docs-page-header__content">
      <div class="docs-page-header__title-row">
        <h1>Components and blocks</h1>
      </div>
      <p class="docs-page-header__lede">Browse Phi components, charts, and blocks.</p>
    </div>
  </header>

  <div class="docs-page-body home-index__body">
    {groups.map((group) => (
      <section class="home-index__section" aria-labelledby={group.id}>
        <div class="home-index__heading">
          <h2 id={group.id}>{group.label}</h2>
          <span class="home-index__count" aria-hidden="true">{group.links.length}</span>
        </div>
        <ul class="home-index__list" aria-labelledby={group.id} role="list">
          {group.links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</div>
