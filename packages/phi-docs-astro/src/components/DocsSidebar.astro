---
import { navGroups, primaryNav } from "../data/docs-nav";

const { pathname = "/", variant = "desktop" } = Astro.props;

const normalizePath = (href: string) => {
  if (href === "/") return "/";
  return href.replace(/\/+$/, "");
};

const currentPath = normalizePath(pathname);

const isCurrent = (href: string) => {
  const normalizedHref = normalizePath(href);
  if (normalizedHref === "/docs") return currentPath === "/docs";
  return currentPath === normalizedHref || currentPath.startsWith(normalizedHref + "/");
};
---

<aside
  class:list={{
    "docs-sidebar-panel": true,
    "docs-sidebar-panel--mobile": variant === "mobile",
    "docs-sidebar-panel--desktop": variant === "desktop",
  }}
  aria-label={variant === "mobile" ? "Mobile navigation" : "Primary navigation"}
>
  {variant === "mobile" ? (
    <div class="docs-sidebar-panel__header">
      <span class="docs-sidebar-panel__title">Phi</span>
      <button
        class="docs-icon-button"
        type="button"
        aria-label="Close menu"
        data-mobile-sidebar-close
      >
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path
            d="M6 6L18 18M18 6L6 18"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  ) : (
    <div class="docs-sidebar-panel__spacer"></div>
  )}

  <div class="docs-sidebar-panel__scroll" data-sidebar-scroll={variant}>
    <button
      class="docs-search"
      type="button"
      aria-label="Search docs"
      aria-controls="docs-search-dialog"
      aria-expanded="false"
      aria-haspopup="dialog"
      data-docs-search-open
    >
      <svg
        class="docs-search__icon"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="6.25" stroke="currentColor" stroke-width="1.8" />
        <path d="M16 16L20 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      <span>Search...</span>
      <kbd class="docs-search__shortcut">⌘K</kbd>
    </button>

    <ul class="docs-nav-list docs-nav-list--primary">
      {primaryNav.map((link) => (
        <li>
          <a
            class:list={{
              "docs-nav-link": true,
              "is-active": isCurrent(link.href),
            }}
            href={link.href}
            aria-current={isCurrent(link.href) ? "page" : undefined}
            data-docs-nav-link
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="docs-sidebar-divider"></div>

    {navGroups.map((group, index) => {
      const panelId = `${variant}-group-${index}`;
      const defaultOpen = group.defaultOpen ?? group.links.some((link) => isCurrent(link.href));

      return (
        <section
          class="docs-nav-group"
          data-nav-group
          data-open={defaultOpen ? "true" : "false"}
        >
          <button
            class="docs-nav-group__toggle"
            type="button"
            aria-controls={panelId}
            aria-expanded={defaultOpen ? "true" : "false"}
            data-nav-group-toggle
          >
            <span>{group.label}</span>
            <svg
              class="docs-nav-group__chevron"
              viewBox="0 0 12 12"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M2 4.25L6 8.25L10 4.25"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>

          <div id={panelId} class="docs-nav-group__panel" data-nav-group-panel>
            <ul class="docs-nav-list docs-nav-group__panel-list">
              {group.links.map((link) => (
                <li>
                  <a
                    class:list={{
                      "docs-nav-link": true,
                      "docs-nav-link--group": true,
                      "is-active": isCurrent(link.href),
                    }}
                    href={link.href}
                    aria-current={isCurrent(link.href) ? "page" : undefined}
                    data-docs-nav-link
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      );
    })}
  </div>
</aside>
