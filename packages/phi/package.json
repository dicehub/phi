  "scripts": {
    "build": "pnpm run codegen:themes && pnpm run codegen:registry && vite build && pnpm run codegen:licenses",
    "check:licenses": "node scripts/generate-third-party-notices.mjs --check",
    "check:registry": "node scripts/component-registry/index.mjs --check",
    "check:semantic-colors": "node scripts/check-semantic-colors.mjs",
    "check:themes": "node scripts/theme-generator/index.mjs --check",
    "codegen:licenses": "node scripts/generate-third-party-notices.mjs",
    "codegen:registry": "node scripts/component-registry/index.mjs",
    "codegen:themes": "node scripts/theme-generator/index.mjs",
    "lint": "pnpm run check:semantic-colors",
    "test": "pnpm run test:unit && pnpm run test:tailwind",
    "test:tailwind": "tailwindcss -i src/styles/__fixtures__/tailwind-input.css -o /tmp/phi-tailwind-integration.css && node scripts/test-tailwind-output.mjs",
    "test:unit": "node --test \"src/**/*.test.mjs\" \"bin/*.test.mjs\"",
    "typecheck": "pnpm run check:themes && pnpm run check:registry && pnpm run check:semantic-colors && vue-tsc --noEmit",
    "validate:package": "pnpm run build && pnpm pack --dry-run --json | node scripts/validate-package.mjs && node scripts/validate-package-consumer.mjs"
  },
  "peerDependencies": {
    "echarts": "^6.0.0",
    "vue": "^3.5.0"
  },
