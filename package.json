{
  "name": "phi-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "pnpm --filter @dicehub/phi-docs-astro dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm test:deployment",
    "test:deployment": "node --test \"scripts/*.test.mjs\"",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "typescript": "^5.9.3"
  }
}
